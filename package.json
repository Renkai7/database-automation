{
  "name": "database-automation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:generate": "pnpm --filter recipe-app exec drizzle-kit generate",
    "db:migrate": "pnpm --filter recipe-app exec drizzle-kit migrate",
    "db:seed": "tsx apps/recipe-app/src/db/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:query": "tsx scripts/db-query.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "db:restore:cluster": "tsx scripts/restore-cluster.ts",
    "db:drill": "tsx scripts/drill.ts",
    "db:analyze": "tsx packages/automation/src/cli.ts",
    "db:analyze:migrations": "tsx packages/automation/src/cli.ts --migrations",
    "dev": "pnpm --filter recipe-app dev",
    "test": "vitest run",
    "test:drill": "vitest run --config vitest.drill.config.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "dotenv": "^17.4.2",
    "execa": "^10.0.1",
    "pg": "8.23.0",
    "pg-connection-string": "2.14.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  }
}
