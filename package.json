{
  "name": "database-automation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:generate": "pnpm --filter recipe-app exec drizzle-kit generate",
    "db:migrate": "pnpm --filter recipe-app exec drizzle-kit migrate",
    "db:seed": "tsx apps/recipe-app/src/db/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:query": "tsx scripts/db-query.ts",
    "dev": "pnpm --filter recipe-app dev",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "dotenv": "^17.4.2",
    "execa": "^10.0.1",
    "pg": "8.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  }
}
