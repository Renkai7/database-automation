# Committed template. Copy to `.env` and fill in a real, locally generated
# password -- never commit `.env` itself (it is gitignored).
#
# Connection variables are app-prefixed and environment-explicit (D-19). A bare,
# unprefixed `DATABASE_URL` is a HARD FAILURE in this project, not a fallback --
# Coolify injects `DATABASE_URL` into linked services by default, so its mere
# presence in the environment must stop the app/tooling from starting rather
# than silently being read (D-20).

# Password used by docker-compose.yml to start the local Postgres container,
# and embedded in RECIPE_DEV_DATABASE_URL below. Generate a random value for
# your real `.env` -- do not reuse this placeholder.
RECIPE_DEV_DB_PASSWORD=PLACEHOLDER

# The only connection variable that exists in Phase 1.
RECIPE_DEV_DATABASE_URL=postgres://recipe_app:PLACEHOLDER@127.0.0.1:5432/recipe_dev

# Reserved for later phases -- do not define these yet.
# RECIPE_STAGING_DATABASE_URL=
# RECIPE_PROD_DATABASE_URL=
